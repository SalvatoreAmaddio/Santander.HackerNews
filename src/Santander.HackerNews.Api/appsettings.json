{
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "FetchTimeoutSeconds": 30,
    "MaxConcurrentUpstreamRequests": 12,
    "StoryCacheSeconds": 60,
    "RankingCacheSeconds": 20,
    "RetryCount": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
